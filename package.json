{
  "name": "domwires",
  "version": "2.0.0",
  "description": "Flexible and extensible MVC framework",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrazyFlasher/domwires-ts"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf dist/ dist-test/ dist_client/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "rimraf dist/ && tsc -p tsconfig.json",
    "test": "rimraf dist-test/ && tsc -p tsconfig.test.json && mocha \"dist-test/test/**/*.js\" --timeout=3000",
    "test-browser": "node browser/build.mjs && http-server ./dist_client -a localhost -p 1234 -o ./test.html",
    "eslint-run": "eslint src test browser --ext .ts,.mjs",
    "copy-files": "copyfiles -u 1 dev.json dist/"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/chai": "5.2.2",
    "@types/mocha": "10.0.10",
    "@types/node": "24.8.1",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "chai": "6.2.0",
    "copyfiles": "2.4.1",
    "esbuild": "0.25.11",
    "eslint": "8.57.1",
    "eslint-plugin-no-type-assertion": "1.3.0",
    "http-server": "14.1.1",
    "mocha": "11.7.4",
    "rimraf": "6.0.1",
    "typescript": "7.0.2"
  }
}
