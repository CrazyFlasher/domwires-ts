{
  "name": "domwires",
  "version": "2.0.0",
  "description": "Flexible and extensible MVC framework",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrazyFlasher/domwires-ts"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "docs/",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf dist/ dist-test/ dist_client/ dist_example/",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.examples.json",
    "build": "rimraf dist/ && tsc -p tsconfig.json",
    "test": "rimraf dist-test/ && tsc -p tsconfig.test.json && mocha \"dist-test/test/**/*.js\" --timeout=3000",
    "test-browser": "node browser/build.mjs && http-server ./dist_client -a localhost -p 1234 -o ./test.html",
    "example:build": "node examples/build.mjs",
    "example:smoke": "node examples/smoke.mjs",
    "example": "npm run example:build && http-server ./dist_example -a localhost -p 1235 -o ./index.html",
    "lint": "oxlint src test browser examples tools",
    "copy-files": "copyfiles -u 1 dev.json dist/"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.1",
    "chai": "4.5.0",
    "copyfiles": "2.4.1",
    "esbuild": "0.28.2",
    "http-server": "14.1.1",
    "mocha": "12.0.2",
    "oxlint": "1.83.0",
    "rimraf": "6.0.1",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
