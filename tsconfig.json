{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noImplicitAny": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "inlineSources": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
